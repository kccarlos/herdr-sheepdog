<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Sheepdog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.github.kccarlos.herdr-sheepdog-ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sheepdog</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Sheepdog uses the camera to scan the pairing code that "sheepdog setup" or "sheepdog pair" shows on your computer, and to take a photo you attach for an agent. A photo goes to the sheepdog daemon on your own computer, and from there to the AI services you set up. Nothing is recorded in the background.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Sheepdog connects to the sheepdog daemon on your own computer, over your local network. What you say or send goes to that computer, and from there to the AI voice and orchestrator services you set up.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sheepdog uses the microphone so you can talk to your coding agents. What you say goes to the sheepdog daemon on your own computer, and from there to the AI voice and orchestrator services you set up. In the demo it stays on this device.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>In the demo, Sheepdog recognises your spoken questions on this device only (on-device recognition). Nothing is sent anywhere.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>SheepdogAppGroup</key>
	<string>$(SHEEPDOG_APP_GROUP)</string>
	<key>SheepdogPushEnvironment</key>
	<string>$(SHEEPDOG_PUSH_ENVIRONMENT)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Sheepdog agent</string>
			<key>UTTypeIdentifier</key>
			<string>com.github.kccarlos.herdr-sheepdog-ios.agent</string>
			<key>UTTypeTagSpecification</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
