# Two ways to get these into the daemon: `set -a; source .env; set +a` (or
# your shell/direnv equivalent) before `bin/sheepdog serve`, or copy this
# file to ./.env and just run `bin/sheepdog serve` — it loads ./.env on its
# own via --env-file (see CONFIG.md), no sourcing needed. Either way, a
# real environment variable always wins over a value from the file, and
# nothing here is ever logged. `sheepdog config show` prints the effective
# config with secrets redacted.

# Gemini API key, used by the voice session (Gemini Live) and by the
# supervisor brain on the gemini provider. Optional extra keys
# GEMINI_API_KEY_1 .. GEMINI_API_KEY_9 form a pool the voice session
# rotates through when one is rate limited.
GEMINI_API_KEY=

# GPT-Live voice provider (optional; CONFIG.md [voice.openai]). Used by the
# voice only, never by the brain. Billed per second of open session; the
# daemon closes it when idle. SHEEPDOG_VOICE_PROVIDER picks the voice the
# daemon starts on (gemini | openai; the /debug picker switches at runtime).
OPENAI_API_KEY=
SHEEPDOG_VOICE_PROVIDER=
SHEEPDOG_VOICE_OPENAI_IDLE_CLOSE_S=

# Supervisor brain (docs/roles.md): the stateful agent that decides and
# phrases, over the Gemini key pool or over DeepSeek with a key below
# (paid per token; selectable at runtime from /debug). All optional; see
# CONFIG.md [brain] and [deepseek].
DEEPSEEK_API_KEY=
SHEEPDOG_DEEPSEEK_THINKING=
SHEEPDOG_DEEPSEEK_REASONING_EFFORT=
SHEEPDOG_BRAIN_ENABLED=
SHEEPDOG_BRAIN_PROVIDER=
SHEEPDOG_BRAIN_MODEL=
SHEEPDOG_BRAIN_MAX_STEPS=
SHEEPDOG_BRAIN_WINDOW_TOKENS=
SHEEPDOG_BRAIN_PRUNE_AFTER_TURNS=

# CLI query tool (plan §3.5, WP4): codex and/or claude, detected on PATH.
# Scalars only; the argv templates (codex_cmd/claude_cmd) are TOML-only,
# see internal/config and docs/cli-query-tools.md. All optional; defaults
# are "auto" prefer, "codex"/"claude" on PATH, 60s timeout, 16 KiB cap.
SHEEPDOG_CLI_PREFER=
SHEEPDOG_CLI_CODEX_BIN=
SHEEPDOG_CLI_CLAUDE_BIN=
SHEEPDOG_CLI_CLAUDE_MODEL=
SHEEPDOG_CLI_CODEX_REASONING=
SHEEPDOG_CLI_TIMEOUT_S=
SHEEPDOG_CLI_MAX_OUTPUT_KB=

# used by tooling only, never by the daemon
GITHUB_PAT=
