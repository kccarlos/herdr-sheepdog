# Gemini API key, used by the voice session (Gemini Live) and as the
# default for SHEEPDOG_LLM_API_KEY below.
GEMINI_API_KEY=

# Cheap LLM adapter: OpenAI-compatible chat endpoint.
SHEEPDOG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SHEEPDOG_LLM_MODEL=gemini-2.5-flash-lite

# defaults to GEMINI_API_KEY
SHEEPDOG_LLM_API_KEY=

# used by tooling only, never by the daemon
GITHUB_PAT=
